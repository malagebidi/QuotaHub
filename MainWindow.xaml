<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="QuotaHub.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:QuotaHub"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="QuotaHub">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" RowDefinitions="Auto,*,Auto" Padding="12" RowSpacing="8" BorderThickness="1">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Escape" Invoked="OnEscapeInvoked" />
        </Grid.KeyboardAccelerators>

        <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
            <TextBlock Text="QuotaHub" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <Button x:Name="RefreshButton" Width="28" Height="28" MinWidth="0" MinHeight="0" Padding="0" Click="OnRefreshClicked" ToolTipService.ToolTip="Refresh">
                    <Grid x:Name="RefreshIconContainer" Width="16" Height="16">
                        <FontIcon FontSize="12" Glyph="&#xE72C;" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </Button>
                <Button x:Name="SettingsButton" Width="28" Height="28" MinWidth="0" MinHeight="0" Padding="0" Click="OnSettingsClicked" ToolTipService.ToolTip="Settings">
                    <FontIcon FontSize="12" Glyph="&#xE713;" />
                </Button>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" x:Name="QuotaScroll">
            <StackPanel x:Name="QuotaList" Spacing="8" />
        </ScrollViewer>

        <ScrollViewer Grid.Row="1" x:Name="SettingsScroll" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="SettingsPanel" Spacing="8">
                <TextBlock Text="OpenRouter API key" />
                <PasswordBox x:Name="OpenRouterKeyBox" PlaceholderText="sk-or-v1-..." />
                <TextBlock Text="DeepSeek API key" />
                <PasswordBox x:Name="DeepSeekKeyBox" PlaceholderText="sk-..." />
                <TextBlock Text="Auto refresh interval" />
                <ComboBox x:Name="AutoRefreshBox">
                    <ComboBoxItem Content="1 minute" Tag="1" />
                    <ComboBoxItem Content="5 minutes" Tag="5" />
                    <ComboBoxItem Content="10 minutes" Tag="10" />
                    <ComboBoxItem Content="15 minutes" Tag="15" />
                    <ComboBoxItem Content="30 minutes" Tag="30" />
                    <ComboBoxItem Content="60 minutes" Tag="60" />
                </ComboBox>
                <TextBlock Text="Global shortcut" />
                <ComboBox x:Name="ShortcutBox">
                    <ComboBoxItem Content="Alt + Q (Default)" Tag="Alt+Q" />
                    <ComboBoxItem Content="Ctrl + Shift + Q" Tag="Ctrl+Shift+Q" />
                    <ComboBoxItem Content="Ctrl + Alt + Q" Tag="Ctrl+Alt+Q" />
                    <ComboBoxItem Content="Alt + Space" Tag="Alt+Space" />
                    <ComboBoxItem Content="Disabled" Tag="None" />
                </ComboBox>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button x:Name="SaveButton" Content="Save" Click="OnSaveClicked" />
                    <TextBlock x:Name="SettingsStatus" VerticalAlignment="Center" Foreground="Gray" FontSize="12" />
                </StackPanel>
                <TextBlock Text="Keys are encrypted with Windows data protection and stored on this device only." TextWrapping="Wrap" Foreground="Gray" FontSize="12" />
            </StackPanel>
        </ScrollViewer>

        <TextBlock Grid.Row="2" x:Name="StatusBar" Foreground="Gray" FontSize="12" Text="Not refreshed yet." />
    </Grid>
</Window>
